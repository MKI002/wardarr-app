{
  "adapter": "qbittorrent",
  "baseUrl": "http://qbittorrent.example.test",
  "credentials": {
    "username": "example-user",
    "password": "example-password"
  },
  "wrongCredentials": {
    "username": "example-user",
    "password": "wrong-password"
  },
  "routes": [
    {
      "method": "POST",
      "path": "/api/v2/torrents/delete",
      "form": {
        "deleteFiles": "true"
      },
      "text": ""
    },
    {
      "method": "POST",
      "path": "/api/v2/auth/login",
      "form": {
        "username": "example-user",
        "password": "example-password"
      },
      "text": "Ok.",
      "responseHeaders": {
        "set-cookie": "SID=fixture-sid; HttpOnly; SameSite=Strict; path=/"
      }
    },
    {
      "method": "POST",
      "path": "/api/v2/auth/login",
      "text": "Fails."
    },
    {
      "path": "/api/v2/app/version",
      "headers": {
        "cookie": "SID=fixture-sid"
      },
      "text": "v5.1.2"
    },
    {
      "path": "/api/v2/app/webapiVersion",
      "headers": {
        "cookie": "SID=fixture-sid"
      },
      "text": "2.11.4"
    },
    {
      "path": "/api/v2/torrents/info",
      "headers": {
        "cookie": "SID=fixture-sid"
      },
      "json": [
        {
          "hash": "0000000000000000000000000000000000000001",
          "name": "Example.Show.S02E01.1080p",

{
  "adapter": "seerr",
  "baseUrl": "http://seerr.example.test",
  "credentials": {
    "apiKey": "00000000000000000000000000000001"
  },
  "wrongCredentials": {
    "apiKey": "00000000000000000000000000000009"
  },
  "routes": [
    {
      "path": "/api/v1/status",
      "json": {
        "version": "3.0.1",
        "commitTag": "v3.0.1",
        "updateAvailable": true,
        "commitsBehind": 0
      }
    },
    {
      "path": "/api/v1/auth/me",
      "headers": {
        "X-Api-Key": "00000000000000000000000000000001"
      },
      "json": {
        "id": 1,
        "email": "admin@example.com",
        "displayName": "Example Admin"
      }
    },
    {
      "path": "*",
      "status": 403,
      "json": {
        "message": "You do not have permission to access this endpoint"
      }
    }
  ],
  "expect": {
    "version": "3.0.1",
    "health": [
      {
        "source": "Status",
        "level": "info",
        "kind": "update"
      }
    ]
  }
}

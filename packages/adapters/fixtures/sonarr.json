            "downloadClient": "Example Client",
            "size": 1000,
            "sizeleft": 400
          },
          {
            "id": 2,
            "title": "Unmatched.Show.S02E03.720p",
            "status": "completed",
            "trackedDownloadStatus": "warning",
            "trackedDownloadState": "importBlocked",
            "statusMessages": [
              {
                "title": "Unmatched.Show.S02E03.720p",
                "messages": ["Unknown item. Unable to match to an existing item"]
              }
            ],
            "downloadId": "FIXTURE0002",
            "protocol": "usenet",
            "size": 2000,
            "sizeleft": 0
          },
          {
            "id": 3,
            "seriesId": 12,
            "title": "Example.Show.S01.Pack",
            "status": "failed",

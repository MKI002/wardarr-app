{
  "adapter": "sonarr",
  "baseUrl": "http://sonarr.example.test",
  "credentials": {
    "apiKey": "00000000000000000000000000000001"
  },
  "wrongCredentials": {
    "apiKey": "00000000000000000000000000000009"
  },
  "routes": [
    {
      "path": "/api/v3/system/status",
      "headers": {
        "X-Api-Key": "00000000000000000000000000000001"
      },
      "json": {
        "appName": "Sonarr",
        "version": "4.0.15.2941"
      }
    },
    {
      "path": "/api/v3/health",
      "headers": {
        "X-Api-Key": "00000000000000000000000000000001"
      },
      "json": [
        {
          "source": "IndexerLongTermStatusCheck",
          "type": "warning",
          "message": "Indexers unavailable due to failures for more than 6 hours: ExampleIndexer (Prowlarr)",
          "wikiUrl": "https://wiki.example.test/system#indexers"
        },
        {
          "source": "UpdateCheck",
          "type": "notice",
          "message": "New update is available: v9.9.9",
          "wikiUrl": "https://wiki.example.test/system#new-update-is-available"
        }
      ]
    },
    {
      "path": "/api/v3/queue",
      "headers": {
        "X-Api-Key": "00000000000000000000000000000001"
      },
      "query": {
        "includeUnknownSeriesItems": "true",
        "page": "1"
      },
      "json": {
        "page": 1,
        "pageSize": 250,
        "totalRecords": 4,
        "records": [
          {
            "id": 1,
            "seriesId": 11,

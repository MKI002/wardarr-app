            "downloadId": "FIXTURE0003",
            "protocol": "usenet",
            "size": 3000,
            "sizeleft": 3000
          }
        ]
      }
    },
    {
      "path": "/api/v3/config/host",
      "headers": {
        "X-Api-Key": "00000000000000000000000000000001"
      },
      "json": {
        "port": 8989,
        "urlBase": "",
        "apiKey": "00000000000000000000000000000001",
        "authenticationMethod": "forms",
        "username": "example-admin",
        "password": "example-password",
        "enableSsl": false,
        "launchBrowser": false
      }
    },
    {
      "path": "*",
      "status": 401,
      "json": {
        "error": "Unauthorized"
      }
